rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 🔓 Allow public read access to pharmacies and products
    match /pharmacies/{pharmacy} {
      allow read: if true;
      allow write: if true; // ⚠️ Public write for scraping script
    }
    match /products/{product} {
      allow read: if true;
      allow write: if request.auth != null; // Temporarily allow auth users to seed
    }
    match /pharmacy_inventory/{item} {
      allow read: if true;
      allow write: if request.auth != null; // Pharmacists can update stock
    }
    
    // 👤 Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 🛒 Orders
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow update: if request.auth != null;
    }

    // 🩺 Consultations & Messages
    match /consultations/{consultationId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.role == 'pharmacist');
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.role == 'pharmacist');
    }
    
    match /messages/{messageId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }

    // 💊 Treatments & 🛡️ Insurances
    match /treatments/{id} {
      allow read, write: if request.auth != null && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    
    match /insurances/{id} {
      allow read, write: if request.auth != null && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    
    // 🏆 Premium Requests
    match /premium_requests/{requestId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null; // For now, all logged in can manage (dev mode)
    }
    
    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}
